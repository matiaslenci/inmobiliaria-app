{
  "name": "inmobiliaria-app",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "echo 'no build needed'",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "electron:build": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "playwright": "^1.55.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.10"
  },
  "build": {
    "appId": "com.tasas.inmobiliariaapp",
    "productName": "Tasas Inmobiliarias",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
